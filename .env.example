# --- Servidor ---
PORT=3000
NODE_ENV=production
# Cadena larga y aleatoria (ej: openssl rand -hex 32)
SESSION_SECRET=cambiar-esto
# Contraseña del panel del dueño
ADMIN_PASSWORD=cambiar-esto

# --- Datos persistentes (fotos + ajustes). Tiene que ser un disco que NO se borre al redeployar ---
DATA_DIR=./data

# --- Google Sheets ---
# ID de la planilla: la parte larga de la URL docs.google.com/spreadsheets/d/<ID>/edit
SHEET_ID=
# Contenido completo del JSON de la cuenta de servicio, en UNA línea
GOOGLE_SERVICE_ACCOUNT_JSON=
# Nombres de las pestañas (por si el dueño las renombra)
TAB_SEMI_1=Stock Seminuevos 1
TAB_SEMI_2=Stock Seminuevos 2
TAB_SELLADOS=Stock Sellados
TAB_VENTAS=Ventas
TAB_DEUDORES=Deudores
TAB_CAJA=Caja
# Moneda en que están cargados los precios de cada pestaña de stock
CURRENCY_SEMI=UYU
CURRENCY_SELLADOS=USD

# --- Contacto ---
WHATSAPP=59891070450

# --- Cotización ---
# Se usa si falla la fuente automática y no hay valor manual cargado en el panel
RATE_FALLBACK=40

CLOUDINARY_CLOUD_NAME=

CLOUDINARY_API_KEY=

CLOUDINARY_API_SECRET=
