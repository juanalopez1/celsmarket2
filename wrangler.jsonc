{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "celsmarket-uy",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-15",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "kv_namespaces": [
    { "binding": "SETTINGS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "vars": {
    "TAB_SEMI_1": "Stock Seminuevos 1",
    "TAB_SEMI_2": "Stock Seminuevos 2",
    "TAB_SELLADOS": "Stock Sellados",
    "TAB_VENTAS": "Ventas",
    "TAB_DEUDORES": "Deudores",
    "TAB_CAJA": "Caja",
    "CURRENCY_SEMI": "UYU",
    "CURRENCY_SELLADOS": "USD",
    "RATE_FALLBACK": "40",
    "WHATSAPP": "59891070450"
  }
}
